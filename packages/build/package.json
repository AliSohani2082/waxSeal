{
  "name": "@waxseal/build",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm build:chrome && pnpm build:firefox",
    "build:chrome": "vite build --config vite.config.ts --mode chrome",
    "build:firefox": "vite build --config vite.config.ts --mode firefox",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@waxseal/adapter-api": "workspace:*",
    "@waxseal/adapter-bale": "workspace:*",
    "@waxseal/crypto-core": "workspace:*",
    "@waxseal/extension-core": "workspace:*"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.277",
    "typescript": "5.6.3",
    "vite": "^5.0.0"
  }
}
