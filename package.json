{
  "name": "waxseal",
  "private": true,
  "version": "0.0.0",
  "description": "End-to-end encryption overlay for web chat apps that don't support it natively.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter ./packages/build run build",
    "build:chrome": "pnpm --filter @waxseal/build run build:chrome",
    "build:firefox": "pnpm --filter @waxseal/build run build:firefox",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "e2e": "pnpm --filter @waxseal/e2e run test"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "packageManager": "pnpm@10.14.0"
}
